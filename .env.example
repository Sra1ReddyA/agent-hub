# Agent Hub has no server, no database and no API keys — the whole bundle generator runs client-side.
# This file exists only so the app's canonical URL is correct in metadata/JSON-LD when deployed.

# Public site URL used for canonical links, Open Graph tags and sitemap.xml. Set this to your real
# deployed domain (e.g. https://agent-hub.dev). Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
