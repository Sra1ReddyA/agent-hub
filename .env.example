# The bundle generator itself has no server, no database and no API keys — it runs entirely client-side.
# Two optional pieces of server-side infrastructure exist purely for the site owner's own /admin dashboard
# (visit + usage analytics): none of it is required for the generator to work.

# Public site URL used for canonical links, Open Graph tags and sitemap.xml. Set this to your real
# deployed domain (e.g. https://agent-hub.dev). Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- /admin dashboard (optional) --------------------------------------------------------------------

# Login credentials for the password-protected /admin page (HTTP Basic Auth, checked in middleware.ts).
# Pick your own values — these are never shipped in the codebase. Without both set, /admin returns a
# 503 explaining it isn't configured yet; the rest of the app is completely unaffected either way.
ADMIN_USER=
ADMIN_PASSWORD=

# Durable storage for /admin's analytics (visit counts, generated-bundle stats) AND for Agent Hub Sync
# (below) — Sync has no in-memory fallback, since forgetting which repos it's watching on every cold start
# isn't acceptable for it the way it's a fine trade-off for analytics. Get a free Redis database either from
# the Vercel Marketplace (Storage → Marketplace Database Providers → a Redis option) or directly at
# https://upstash.com — either one gives you these two values to paste in.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Agent Hub Sync — GitHub App that keeps generated files current (optional) ------------------------

# Set up at /sync, which walks through creating your own GitHub App via GitHub's one-click "manifest"
# flow and hands you these four values to paste in afterward — don't fill these in by hand. Without all
# four set, every /api/github/* and /api/cron/* route 503s and the rest of the app is unaffected.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Any random string you choose — authenticates Vercel's daily cron hit to /api/cron/resync (Vercel attaches
# this automatically as a Bearer token to its own cron requests once this env var exists on the project;
# see vercel.json's "crons" entry). Required for the daily "did Agent Hub's own guardrails change" check;
# the push-triggered "did my dependencies change" check works without it.
CRON_SECRET=

# --- Multi-tenant /dashboard (optional, on top of Agent Hub Sync above) --------------------------------

# Only needed if you're running this as a HOSTED instance other people install into their own repos, rather
# than a self-hosted one just for you. Enables a GitHub-login-gated /dashboard where each installer sees and
# edits only their own repos — separate from /admin, which is Basic-Auth-protected and (correctly, for a
# self-hosted single-operator setup) sees everything. Set up at /sync's App-creation page, "1b" step, which
# hands you all three of these — don't fill them in by hand. Skip this whole block for self-hosting.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
SESSION_SECRET=
